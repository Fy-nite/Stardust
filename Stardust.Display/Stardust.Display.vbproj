<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Stardust.Display</RootNamespace>
    <TargetFramework>net9.0</TargetFramework>
    <Title>Stardust Display Server</Title>
    <Description>Xorg-style compositing display server and UI toolkit for Stardust OS. Usable both as a standalone app and as a library.</Description>
    <AssemblyName>Stardust.Display</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.2" />
    <PackageReference Include="Avalonia.Headless" Version="12.1.2" />
    <PackageReference Include="Avalonia.Skia" Version="12.1.2" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.2" />
    <PackageReference Include="FontStashSharp.MonoGame" Version="1.5.9" />
    <PackageReference Include="MonoGame.Extended" Version="6.1.1" />
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.5.1" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\FiraCode-Regular.ttf" />
    <EmbeddedResource Include="Assets\FiraCode-Medium.ttf" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Stardust.Core\Stardust.Core.vbproj" />
    <ProjectReference Include="..\Stardust.Kernel\Stardust.Kernel.vbproj" />
  </ItemGroup>

</Project>
